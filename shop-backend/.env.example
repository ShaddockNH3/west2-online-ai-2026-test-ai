# 复制为 .env 后按需修改；不要把真实密钥提交进仓库。

# 本机演示默认用 SQLite，零依赖即可跑通全部功能与测试。
# 切 MySQL 时改成：mysql+asyncmy://shop:shop_pwd@127.0.0.1:3306/shop?charset=utf8mb4
SHOP_DATABASE_URL=sqlite+aiosqlite:///./var/shop.db

# JWT 签名密钥。生产环境请用 `python -c "import secrets;print(secrets.token_urlsafe(48))"` 生成
SHOP_JWT_SECRET=dev-only-change-me-please-use-a-random-secret

# Access Token 30 分钟，Refresh Token 7 天
SHOP_ACCESS_TTL=1800
SHOP_REFRESH_TTL=604800

# 商品目录缓存。留空不启用；填 redis://127.0.0.1:6379/0 才走 Redis
SHOP_REDIS_URL=
SHOP_CACHE_TTL=20

# 订单超时未支付的关闭时间（分钟）
SHOP_ORDER_EXPIRE_MINUTES=30

# 是否启动持久化后台任务 worker，以及 worker 数量与轮询间隔
SHOP_WORKER_ENABLED=true
SHOP_WORKER_CONCURRENCY=2
SHOP_WORKER_POLL_INTERVAL=0.5

# 演示数据：初始化脚本会创建这两个账号
SHOP_ADMIN_USERNAME=admin
SHOP_ADMIN_PASSWORD=admin123456
SHOP_DEMO_USERNAME=demo
SHOP_DEMO_PASSWORD=demo123456

SHOP_LOG_LEVEL=INFO
